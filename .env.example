# AGENDAPP · Equipo 5 · Grupo 3 · Programación Avanzada · FET
#
# VARIABLES DE ENTORNO DEL SISTEMA (documentación)
#
# Este archivo es DOCUMENTAL. docker-compose.yml no usa `${VARIABLE}`, así que
# Compose NO lee un archivo `.env` para estas variables: copiarlo a `.env` no
# cambia nada. El sistema arranca sin ningún archivo adicional porque cada
# variable ya trae un valor por defecto, en docker-compose.yml o en el
# application.properties del servicio (se indica en cada caso).
#
# Para cambiar una variable sin tocar docker-compose.yml, cree junto a él un
# `docker-compose.override.yml` (Compose lo carga solo; está en .gitignore):
#
#   services:
#     gateway-graphql:
#       environment:
#         JWT_SECRET: "una-clave-de-al-menos-32-caracteres"
#
# y aplique con `docker compose up -d --no-deps <servicio>`.
#
# Todos los valores de abajo son de DEMOSTRACIÓN y ficticios. No hay secretos
# reales en el repositorio. Cambie los marcados con <...> antes de cualquier
# uso fuera de una demostración local.

# ── Seguridad del inicio de sesión (gateway-graphql) ────────────────────────
# NO las pasa docker-compose.yml: aplica el valor por defecto del
# application.properties del gateway (un secreto de desarrollo).
# Mínimo 32 caracteres; con menos el gateway no arranca.
JWT_SECRET=<defina-una-clave-de-al-menos-32-caracteres>
# Duración de la sesión en minutos (por defecto 480 = 8 horas).
JWT_MINUTOS=480

# ── Usuario de demostración del panel (ms-establecimientos) ─────────────────
# NO las pasa docker-compose.yml: aplican los valores por defecto del
# application.properties. Con SEMILLA_USUARIO_ACTIVA=false no se crea el usuario.
SEMILLA_USUARIO_ACTIVA=true
SEMILLA_USUARIO_CORREO=admin@demo.com
SEMILLA_USUARIO_CLAVE=demo1234

# ── Base de datos PostgreSQL ────────────────────────────────────────────────
# Servicio `postgres` del compose (imagen postgres:16). Un esquema por servicio.
POSTGRES_USER=citas
POSTGRES_PASSWORD=citas
POSTGRES_DB=citas
# Lo leen ms-agenda, ms-establecimientos, ms-operaciones y ms-relacion-cliente.
# El compose los fija así; fuera de Docker el valor por defecto apunta a localhost.
DB_URL=jdbc:postgresql://postgres:5432/citas
DB_USER=citas
DB_PASSWORD=citas

# ── Kafka ───────────────────────────────────────────────────────────────────
# Lo leen ms-agenda, ms-operaciones y ms-relacion-cliente.
# Dentro de Docker: kafka:29092. Desde el equipo: localhost:9092.
KAFKA_SERVERS=kafka:29092
# Identificador del clúster KRaft (servicio `kafka` del compose).
CLUSTER_ID=agenda-cluster-local-0001

# ── Direcciones entre servicios ─────────────────────────────────────────────
# Nombres de servicio de Docker; fuera de Docker el valor por defecto es localhost.
# ESTABLECIMIENTOS_URL: gateway-graphql, ms-operaciones, ms-relacion-cliente, simulador
ESTABLECIMIENTOS_URL=http://ms-establecimientos:8081
# AGENDA_URL: gateway-graphql, ms-relacion-cliente, simulador
AGENDA_URL=http://ms-agenda:8080
# OPERACIONES_URL: gateway-graphql, simulador
OPERACIONES_URL=http://ms-operaciones:8082
# RELACION_URL: gateway-graphql
RELACION_URL=http://ms-relacion-cliente:8083

# ── Recordatorios (ms-relacion-cliente) ─────────────────────────────────────
# NO las pasa docker-compose.yml: aplican los valores por defecto.
# Activo por defecto; false lo apaga.
RECORDATORIOS_ACTIVO=true
# Cada cuántos milisegundos se revisan las citas próximas.
RECORDATORIOS_CADA_MS=60000
# Espera antes de la primera revisión, en milisegundos.
RECORDATORIOS_ESPERA_INICIAL_MS=30000

# ── Simulador de actividad ──────────────────────────────────────────────────
# El compose lo enciende ("true"). Por defecto en el código es false.
# Poner false deja de generar citas sintéticas.
SIMULADOR_ACTIVO=true
# Milisegundos entre citas generadas.
SIMULADOR_INTERVALO_MS=15000
