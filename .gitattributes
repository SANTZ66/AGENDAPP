# Normaliza saltos de linea: los scripts y la configuracion que corren en
# Linux (contenedores, Git Bash) deben llevar LF aunque se editen en Windows.
* text=auto
*.sh text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf

# Binarios: no tocar
*.png binary
*.jpg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
