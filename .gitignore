# Compilados y dependencias (se regeneran dentro de los contenedores)
target/
*.class
*.jar
node_modules/
dist/

# Configuracion local: se versiona .env.example, nunca .env
.env
.env.*
!.env.example
.env.local

# Ajustes temporales de ejecucion
