# Herramientas y editores
.claude/
.idea/
.vscode/
*.iml

# Registros, temporales y respaldos
*.log
*.out
*.tmp
*.bak
*.swp

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Entregables generados (el ZIP se produce con git archive)
*.zip
